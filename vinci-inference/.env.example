# Vinci inference local runtime defaults
# Copy to .env when you need custom values.

# device: auto | cuda | mps | cpu
VINCI_DEVICE=auto
RUNNING_LANGUAGE=chn
VERSION=v1

# HTTP service binding
VINCI_HOST=0.0.0.0
VINCI_PORT=8010

# Preload InternVL models in background when service starts.
# true: reduces first-request cold-start waiting
VINCI_PRELOAD_MODELS=true

# Prefer local model files for deterministic startup and quick failure on missing weights.
VINCI_LOCAL_ONLY=true
VINCI_MODEL_PATH=../Vinci-8B-base
VINCI_CKPT_PATH=../Vinci-8B-ckpt
